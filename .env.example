# ─────────────────────────────────────────────────────────────────────────────
# Variaveis de ambiente — Controlo de Fermentacao Vinicola
# Copie este ficheiro para `.env` e preencha os valores.
# ─────────────────────────────────────────────────────────────────────────────

# ── Obrigatorias ────────────────────────────────────────────────────────────

# Ambiente de execucao: use sempre "production" em servidor.
NODE_ENV=production

# Porta HTTP do servidor. Muitos servicos de alojamento definem esta variavel
# automaticamente; se for o caso, nao a defina manualmente.
PORT=3000

# Ligacao MySQL / TiDB.
# Formato: mysql://utilizador:password@host:porta/base_de_dados
# Com TLS obrigatorio (ex. TiDB Cloud, PlanetScale) acrescente ?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://utilizador:password@host:3306/fermentacao

# Segredo usado para assinar os cookies de sessao (JWT HS256).
# Gere um valor aleatorio longo, por exemplo:  openssl rand -base64 48
# ATENCAO: ao mudar este valor todas as sessoes activas sao invalidadas.
JWT_SECRET=substituir_por_segredo_aleatorio_longo

# Identificador da aplicacao, incluido no payload do JWT.
# Qualquer texto estavel serve; nao mudar depois de entrar em producao.
VITE_APP_ID=fermentacao-vinicola


# ── Opcionais ───────────────────────────────────────────────────────────────

# Envio de email (relatorios e digest diario) atraves do servico Resend.
# Sem esta chave a aplicacao funciona normalmente, apenas nao envia emails.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Login atraves de um portal OAuth externo. Deixe vazio para usar apenas as
# contas locais (email + password) guardadas na tabela `local_users`.
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=

# Identificador do proprietario, que recebe automaticamente o papel de admin.
# OWNER_OPEN_ID=
